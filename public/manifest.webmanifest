{
  "name": "BYU Campus Calendar",
  "short_name": "BYU Events",
  "description": "Every BYU event in one place, filtered to what you care about.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#002E5D",
  "theme_color": "#002E5D",
  "categories": ["education", "events", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "short_name": "Today", "url": "/?view=app&range=today" },
    { "name": "This weekend", "short_name": "Weekend", "url": "/?view=app&range=weekend" },
    { "name": "My interests", "short_name": "My feed", "url": "/?view=feed" }
  ]
}
