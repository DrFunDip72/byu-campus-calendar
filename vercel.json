{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/feed.ts": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/feed.ics", "destination": "/api/feed" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
